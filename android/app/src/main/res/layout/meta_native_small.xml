<?xml version="1.0" encoding="utf-8"?>
<!-- Meta native banner ad for the small slot: icon row + button, centered in
     whatever height the Flutter slot gives it. Mirrors the AdMob small template. -->
<com.facebook.ads.NativeAdLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/meta_ad_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.facebook.ads.MediaView
                    android:id="@+id/meta_ad_icon"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_marginHorizontal="5dp" />

                <include layout="@layout/meta_native_texts" />
            </LinearLayout>

            <include layout="@layout/meta_native_cta" />
        </LinearLayout>

        <include layout="@layout/meta_native_choices" />
    </FrameLayout>
</com.facebook.ads.NativeAdLayout>
