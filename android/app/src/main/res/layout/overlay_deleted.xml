<?xml version="1.0" encoding="utf-8"?>
<!-- DeletedOverlay's popup (a deleted or edited message). Collapsed: header + 2 lines of the
     message + "tap" hint. Expanded (overlay_expanded visible): the whole message, Copy / Open
     WhatsApp, the native ad, "See all deleted messages". -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <LinearLayout
        android:id="@+id/overlay_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_overlay_card"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/overlay_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_stat_message_alert" />

            <TextView
                android:id="@+id/overlay_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/overlay_on_surface"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/overlay_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/overlay_on_surface_variant"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/overlay_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/overlay_close"
                android:padding="6dp"
                android:src="@drawable/ic_overlay_close" />
        </LinearLayout>

        <TextView
            android:id="@+id/overlay_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/overlay_on_surface"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/overlay_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/overlay_tap_hint"
            android:textColor="@color/overlay_on_surface_variant"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/overlay_expanded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/overlay_copy"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_overlay_button_outline"
                    android:gravity="center"
                    android:text="@string/overlay_copy"
                    android:textColor="@color/overlay_accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/overlay_open_chat_app"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_overlay_button_outline"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="@color/overlay_accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Debug builds only (DeletedOverlay.adStatus): where the ad got to. -->
            <TextView
                android:id="@+id/overlay_ad_debug"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_overlay_ad"
                android:padding="8dp"
                android:textColor="@color/overlay_deleted"
                android:textIsSelectable="false"
                android:textSize="11sp"
                android:typeface="monospace"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/overlay_ad_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/overlay_open_app"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_overlay_button"
                android:gravity="center"
                android:text="@string/overlay_open_app"
                android:textColor="@color/overlay_on_accent"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
